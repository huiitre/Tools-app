# Copier vers .env (gitignored) et renseigner. Lu par les scripts de scripts/ (npm run sync,
# npm run db:clone) et par dev-console/server.js pour les identifiants Postgres.

# Serveur SSH du NAS. Obligatoire pour npm run sync et npm run db:clone.
SSH_HOST=ip-server
SSH_USER=username
SSH_PORT=port

# Optionnel : identifiants Postgres, seulement si pas déjà exportés globalement dans ton shell
# (api Java et api-core C# lisent tous les deux DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD).
# Laisser vide si ton .bashrc/.zshrc les exporte déjà.
#DB_NAME=tools_dev
#DB_USERNAME=username
#DB_PASSWORD=password

# ---------------------------------------------------------------------------
# Synchronisation des données du NAS (npm run sync) — tout est optionnel.
# ---------------------------------------------------------------------------

# Emplacements sur le NAS, à ne changer que si l'arborescence bouge.
#REMOTE_ASSETS_PATH=/data/docker/tools/tools_assets
#REMOTE_SNAPSHOTS_PATH=/data/docker/tools/tools_palworld_server_data_extractor/data/json

# Emplacements locaux. Par défaut ceux que lisent les API en dev (tools.assets.base-path et
# palworld.server-data.path) : à surcharger si tu ne veux pas recréer l'arborescence du NAS.
#LOCAL_ASSETS_PATH=/data/docker/tools/tools_assets
#LOCAL_SNAPSHOTS_PATH=/data/docker/tools/tools_palworld_server_data_extractor/data/json

# ---------------------------------------------------------------------------
# Base locale (npm run db:up / db:clone) — tout est optionnel.
# ---------------------------------------------------------------------------

# Port exposé par le conteneur Postgres local, et sur lequel dev-console fait pointer les API.
#LOCAL_DB_PORT=5433

# Emplacement des scripts db-dump.sh / db-restore.sh sur le NAS.
#REMOTE_SCRIPTS_PATH=/data/docker/tools/scripts
