<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);logs/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Diagrammes de dépendances régénérés à chaque compilation, pour qu'ils ne dérivent jamais du
       code. Inputs/Outputs rendent la cible incrémentale : MSBuild la saute tant qu'aucun .cs
       n'est plus récent que les diagrammes, ce qui compte pour « dotnet watch », qui reconstruit
       à chaque sauvegarde. ContinueOnError car le script a besoin de Python et de Graphviz : leur
       absence ne doit jamais casser une compilation. -->
  <Target Name="GenerateDiagrams" AfterTargets="Build"
          Inputs="@(Compile)" Outputs="docs/diagrams/00-modules.md">
    <Exec Command="python3 docs/diagrams/uml.py"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

</Project>
