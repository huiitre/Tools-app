{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}      {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://tools.huiitre.fr",
      "app://."
    ]
  },
  "App": {
    "FrontendBaseUrl": "https://tools.huiitre.fr"
  },
  "ReverseProxy": {
    "TrustedProxies": [
      "172.18.0.11"
    ]
  },
  "Google": {
    "OAuth": {
      "RedirectUri": "https://api.tools.huiitre.fr/api/core/auth/callback/google",
      "FrontendBaseUrl": "https://tools.huiitre.fr"
    }
  },
  "Mail": {
    "Smtp": {
      "Host": "ssl0.ovh.net",
      "FromAddress": "admin@huiitre.fr"
    }
  },
  "AndroidApps": {
    "Environment": "prod"
  },
  "Huihuistore": {
    "PackageName": "fr.huiitre.huihuistore",
    "CertificateSha256": "9474c87dfd700e1fcad6afd4f539e42e957a4ae1e19abd2a166c2607d7cd682e"
  }
}
