# Copier vers .env (gitignored) et renseigner. Utilisé uniquement par dev-console/server.js
# (npm run dev / npm run dev:qa) pour ouvrir le tunnel SSH vers Postgres quand la base n'est
# pas joignable en direct (hors du LAN maison).

# Serveur SSH pour le tunnel Postgres (obligatoire si LAN_DB_HOST est absent/injoignable)
SSH_HOST=ip-server
SSH_USER=username
SSH_PORT=port

# Optionnel : IP/port Postgres sur le LAN maison. Si renseigné et joignable, dev-console saute
# le tunnel SSH et se connecte en direct. Si absent, dev-console tunnelise systématiquement.
LAN_DB_HOST=192.168.1.23
LAN_DB_PORT=5432

# Optionnel : identifiants Postgres, seulement si pas déjà exportés globalement dans ton shell
# (api Java et api-core C# lisent tous les deux DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD).
# Laisser vide si ton .bashrc/.zshrc les exporte déjà.
#DB_NAME=tools_dev
#DB_USERNAME=username
#DB_PASSWORD=password
