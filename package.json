{
  "name": "tools-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node dev-console/server.js",
    "dev:qa": "node dev-console/server.js qa",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:clone": "bash scripts/db-clone.sh",
    "sync": "npm run sync:assets && npm run sync:snapshots",
    "sync:assets": "bash scripts/sync-assets.sh",
    "sync:snapshots": "bash scripts/sync-snapshots.sh",
    "api:dev": "cd api && DOTNET_WATCH_RESTART_ON_RUDE_EDIT=1 dotnet watch run",
    "api:build": "cd api && dotnet build && cd ..",
    "api:diagrams": "python3 api/docs/diagrams/uml.py",
    "api:test": "npm run api:test:unit && npm run api:test:integration",
    "api:test:unit": "dotnet test api/tests/Tools.Api.UnitTests/Tools.Api.UnitTests.csproj",
    "api:test:integration": "dotnet test api/tests/Tools.Api.IntegrationTests/Tools.Api.IntegrationTests.csproj",
    "api:clean": "cd api && dotnet clean && cd ..",
    "api:restore": "cd api && dotnet restore && cd ..",
    "api:format": "cd api && dotnet format && cd ..",
    "api:check": "dotnet build api/Tools.Api.csproj && npm run api:test",
    "java:dev": "cd api-java && SPRING_PROFILES_ACTIVE=dev mvn spring-boot:run",
    "java:build": "cd api-java && mvn clean package && cd ..",
    "web:dev": "npm run dev --prefix web",
    "web:dev:qa": "npm run dev:qa --prefix web",
    "web:build": "cd web && npm run test && npm run build && cd ..",
    "electron:watch": "cd web && npm run electron:watch",
    "electron:build": "cd web && npm run electron:build && cd ..",
    "electron:build:qa": "cd web && npm run electron:build:qa"
  }
}
