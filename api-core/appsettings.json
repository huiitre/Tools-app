{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Application": {
    "Version": "0.1.0"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "tools-api",
      "AccessTokenTtlSeconds": 600,
      "RefreshTokenTtlSeconds": 604800,
      "RefreshCookieName": "refresh_token",
      "RefreshCookiePath": "/"
    },
    "PasswordReset": {
      "TokenBytes": 32,
      "TokenTtlMinutes": 30,
      "ResetPath": "/auth/reset-password"
    }
  },
  "Mail": {
    "Smtp": {
      "Port": 587,
      "EnableSsl": true
    }
  },
  "AllowedHosts": "*"
}
