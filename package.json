{
  "name": "tools-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix web\" \"cd api && SPRING_PROFILES_ACTIVE=dev mvn spring-boot:run\"",
    "api:build": "cd api && mvn clean package && ../",
    "web:build": "cd web && npm run build && ../",
    "electron:build": "cd web && npm run electron:build && ../",
    "electron:watch": "cd web && npm run electron:watch"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}